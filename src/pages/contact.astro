---
import Base from "@/layouts/Base.astro";
import { getListPage } from "@/lib/contentParser.astro";
import PageHeader from "@/partials/PageHeader.astro";
import ContactForm from "@/components/shop/ContactForm";

const contactIndex = await getListPage("contact", "-index");
const { title, description, meta_title, image } = contactIndex.data;

if (contactIndex.data.draft) {
  return Astro.redirect("/404");
}
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
>
  <section class="section-sm">
    <div class="container">
      <div class="row">
        <div class="mx-auto md:col-10 lg:col-6">
          <div class="text-center mb-6">
            <img
              src="/images/logo.png"
              alt="Logo Miranda"
              class="w-32 h-auto mx-auto mb-4"
            />
            <h2 class="text-2xl font-bold">PEDIDOS MIRANDA</h2>
          </div>
          <ContactForm client:load />
        </div>
      </div>
    </div>
  </section>
</Base>
