---
import Base from "@/layouts/Base.astro";
import CartModal from "@/components/shop/CartModal";
import CheckoutForm from "@/components/shop/CheckoutForm";
---

<Base title="Finalizar Compra - Importadora Miranda">
  <section class="section pt-8">
    <div class="container">

      <div
        class="max-w-4xl mx-auto  dark:bg-darkmode-theme-light p-5 rounded-lg shadow-lg border border-border dark:border-darkmode-border"
      >
        <CheckoutForm client:only="react" />
      </div>
    </div>
  </section>
  <CartModal client:only="react" />
</Base>
