---
import Base from "../../layouts/Base.astro";
import CartModal from "../../components/shop/CartModal"; // Re-usamos pero mostramos en linea si es posible o creamos uno de pagina completa
import CheckoutForm from "../../components/shop/CheckoutForm"; // Nuevo componente
---

<Base title="Finalizar Compra - Importadora Miranda">
  <section class="section pt-14">
    <div class="container">
      <h1 class="h3 mb-8 text-center">Finalizar Compra</h1>

      <div
        class="max-w-4xl mx-auto bg-white dark:bg-darkmode-theme-light p-8 rounded-lg shadow-lg border border-border dark:border-darkmode-border"
      >
        <CheckoutForm client:load />
      </div>
    </div>
  </section>
  <CartModal client:only="react" />
</Base>
