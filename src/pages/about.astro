    @keyframes gradient-x {
      0%,
      100% {
        background-position: 0% 50%;
      }
      50% {
        background-position: 100% 50%;
      }
    }
    .animate-gradient-x {
      background-size: 200% 100%;
      animation: gradient-x 15s ease infinite;
    }
  </style>

  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    gsap.registerPlugin(ScrollTrigger);

    // Initial animations
    window.addEventListener("load", () => {
      const tl = gsap.timeline();

      tl.from("#hero-logo", {
        y: 50,
        opacity: 0,
        scale: 0.8,
        duration: 1.5,
        ease: "elastic.out(1, 0.5)",
      })
        .from(
          "#hero-title",
          {
            y: 30,
            opacity: 0,
            duration: 1,
            ease: "power3.out",
          },
          "-=1",
        )
        .from(
          "#hero-phrase",
          {
            scale: 0.9,
            opacity: 0,
            duration: 1,
            ease: "power2.out",
          },
          "-=0.5",
        )
        .from(
          "#about-content",
          {
            y: 50,
            opacity: 0,
            duration: 1.2,
            ease: "power4.out",
          },
          "-=0.7",
        );

      // Floating effect for logo
      gsap.to("#hero-logo", {
        y: -15,
        duration: 3,
        repeat: -1,
        yoyo: true,
        ease: "sine.inOut",
      });

      // Scroll to map section on load or hash change
      const scrollToMap = () => {
        if (window.location.hash === "#map-section") {
          const mapSection = document.getElementById("map-section");
          if (mapSection) {
            setTimeout(() => {
              mapSection.scrollIntoView({ behavior: "smooth" });
            }, 800);
          }
        }
      };

      // Initial check
      scrollToMap();

      // Listen for view transitions or hash changes
      window.addEventListener("hashchange", scrollToMap);
      document.addEventListener("astro:after-swap", scrollToMap);

      // Scroll animations for sections
      gsap.from(".section:last-of-type", {
        scrollTrigger: {
          trigger: ".section:last-of-type",
          start: "top 80%",
        },
        y: 60,
        opacity: 0,
        duration: 1.5,
        ease: "power4.out",
      });
    });
  </script>
</Base>
