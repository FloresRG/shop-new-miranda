---
import Base from "@/layouts/Base.astro";
import { getListPage } from "@/lib/contentParser.astro";
import { markdownify } from "@/lib/utils/textConverter";
import { render } from "astro:content";
import { Image } from "astro:assets";
import logo from "@/assets/logo.webp";

const aboutIndex = await getListPage("about", "-index");
const { Content } = await render(aboutIndex);
const { title, description, meta_title } = aboutIndex.data;

if (aboutIndex.data.draft) {
  return Astro.redirect("/404");
}
---

<Base title={title} meta_title={meta_title} description={description}>
  <section class="relative overflow-hidden py-20 lg:py-32">
    <!-- Animated background elements -->
    <div
      class="absolute top-0 left-0 w-full h-full -z-10 opacity-30 dark:opacity-20 pointer-events-none"
    >
      <div
        class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] bg-primary rounded-full blur-[120px] animate-pulse"
      >
      </div>
      <div
        class="absolute bottom-[-10%] right-[-10%] w-[40%] h-[40%] bg-[#FF0040] rounded-full blur-[120px] animate-pulse"
        style="animation-delay: 2s"
      >
      </div>
    </div>

    <div class="container relative z-10">
      <div class="row justify-center text-center">
        <div class="lg:col-10">
          <!-- Logo Section -->
          <div class="mb-12 relative inline-block group" id="hero-logo">
            <div
              class="absolute inset-0 bg-primary/20 blur-2xl rounded-full scale-0 group-hover:scale-150 transition-transform duration-700"
            >
            </div>
            <Image
              src={logo}
              width={350}
              height={350}
              alt="Importadora Miranda Logo"
              class="relative z-10 mx-auto drop-shadow-[0_20px_50px_rgba(128,0,128,0.3)] dark:drop-shadow-[0_20px_50px_rgba(255,0,64,0.4)] transition-all duration-500 hover:scale-105"
            />
          </div>

          <!-- Hero Text -->
          <h1
            class="text-4xl md:text-6xl lg:text-7xl font-black mb-8 leading-tight tracking-tight bg-gradient-to-r from-primary via-[#FF0040] to-primary bg-clip-text text-transparent animate-gradient-x"
            id="hero-title"
          >
            IMPORTADORA MIRANDA
          </h1>

          <p
            class="text-xl md:text-3xl font-bold text-gray-800 dark:text-white/90 mb-12 italic tracking-wide"
            id="hero-phrase"
          >
            "A un click del producto que necesitas"
          </p>

          <div class="max-w-3xl mx-auto">
            <div
              class="bg-white/40 dark:bg-darkmode-light/20 backdrop-blur-xl border border-white/20 dark:border-white/10 p-8 md:p-12 rounded-[40px] shadow-2xl relative overflow-hidden"
              id="about-content"
            >
              <!-- Decorative corner -->
              <div
                class="absolute top-0 right-0 w-24 h-24 bg-gradient-to-br from-primary/10 to-transparent rounded-bl-[100px]"
              >
              </div>

              <h2
                class="h3 mb-8 text-primary dark:text-[#FF0040] font-black uppercase tracking-widest text-sm"
              >
                Nuestra Misión
              </h2>

              <div
                class="content text-lg md:text-xl text-gray-700 dark:text-gray-300 leading-relaxed space-y-6 font-medium"
              >
                <Content />
              </div>

              <div class="mt-12 flex flex-wrap justify-center gap-6">
                <div
                  class="px-6 py-4 bg-primary/10 dark:bg-primary/20 rounded-2xl border border-primary/20 backdrop-blur-sm"
                >
                  <span class="block text-2xl font-black text-primary"
                    >100%</span
                  >
                  <span
                    class="text-xs uppercase font-bold tracking-widest text-primary/70"
                    >Interés por el cliente</span
                  >
                </div>
                <div
                  class="px-6 py-4 bg-[#FF0040]/10 dark:bg-[#FF0040]/20 rounded-2xl border border-[#FF0040]/20 backdrop-blur-sm"
                >
                  <span class="block text-2xl font-black text-[#FF0040]"
                    >24/7</span
                  >
                  <span
                    class="text-xs uppercase font-bold tracking-widest text-[#FF0040]/70"
                    >Mejora continua</span
                  >
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Commitment Section -->
  <section
    class="section py-24 bg-gray-50 dark:bg-darkmode-body overflow-hidden"
  >
    <div class="container">
      <div class="row align-items-center">
        <div class="md:col-6 mb-12 md:mb-0">
          <div class="relative">
            <div
              class="absolute -top-10 -left-10 w-40 h-40 bg-primary/10 rounded-full blur-3xl"
            >
            </div>
            <h2
              class="h2 mb-6 font-black leading-tight text-gray-900 dark:text-white"
            >
              Nos interesa mucho <br /><span class="text-primary italic"
                >tu experiencia</span
              >
            </h2>
            <p
              class="text-lg text-gray-600 dark:text-gray-400 mb-8 leading-relaxed"
            >
              En Importadora Miranda no solo vendemos productos; creamos
              conexiones. Trabajamos incansablemente para mejorar cada día,
              optimizando nuestros procesos para que encuentres exactamente lo
              que buscas en cuestión de segundos.
            </p>
            <div class="space-y-4">
              <div class="flex items-center gap-4">
                <div
                  class="w-12 h-12 bg-primary/20 rounded-xl flex items-center justify-center text-primary"
                >
                  <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20"
                    ><path
                      d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    ></path></svg
                  >
                </div>
                <span
                  class="font-bold text-gray-800 dark:text-gray-200 uppercase tracking-wide text-sm"
                  >Atención Personalizada</span
                >
              </div>
              <div class="flex items-center gap-4">
                <div
                  class="w-12 h-12 bg-[#FF0040]/20 rounded-xl flex items-center justify-center text-[#FF0040]"
                >
                  <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20"
                    ><path
                      d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    ></path></svg
                  >
                </div>
                <span
                  class="font-bold text-gray-800 dark:text-gray-200 uppercase tracking-wide text-sm"
                  >Envío Seguro a Nivel Nacional</span
                >
              </div>
            </div>
          </div>
        </div>
        <div class="md:col-6">
          <div
            class="bg-gradient-to-br from-primary to-[#FF0040] p-[2px] rounded-[40px] shadow-2xl transform rotate-1 hover:rotate-0 transition-transform duration-500"
          >
            <div
              class="bg-white dark:bg-darkmode-light p-10 rounded-[38px] h-full flex flex-col justify-center"
            >
              <div
                class="text-6xl font-black text-primary/10 dark:text-white/5 mb-4"
              >
                "
              </div>
              <p
                class="text-2xl italic font-bold text-gray-900 dark:text-white leading-relaxed"
              >
                "Nuestra meta es que Importadora Miranda sea sinónimo de
                confianza y excelencia. Cada click es un voto de confianza que
                honramos con calidad."
              </p>
              <div class="mt-8 flex items-center gap-4">
                <div class="w-12 h-2 bg-primary rounded-full"></div>
                <span
                  class="font-black uppercase tracking-widest text-xs text-primary"
                  >Equipo Miranda</span
                >
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- Map Section -->
  <section id="map-section" class="section py-24 relative overflow-hidden">
    <div class="absolute inset-0 bg-primary/5 dark:bg-primary/10 -z-10"></div>

    <div class="container relative z-10">
      <div class="row justify-center">
        <div class="lg:col-10 text-center">

          <h2 class="h2 mb-4 font-black text-gray-900 dark:text-white uppercase tracking-tight">
            Nuestra Ubicación <br />
            <span class="text-primary italic">Tienda Física</span>
          </h2>

          <p class="text-lg text-gray-600 dark:text-gray-400 mb-8 max-w-2xl mx-auto">
            Visítanos en nuestras sucursales y descubre todos nuestros productos en persona.
          </p>

          <!-- 1. BOTONES DE SELECCIÓN (Con ícono SVG) -->
          <div class="flex flex-col sm:flex-row justify-center items-center gap-4 mb-10">
            <button
              id="btn-caparazon"
              class="map-btn px-8 py-3 rounded-full font-bold transition-all duration-300 bg-primary text-white shadow-lg shadow-primary/30 transform scale-105 cursor-pointer flex items-center"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 mr-2 flex-shrink-0">
                <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/>
                <path d="m9 10 2 2 4-4"/>
              </svg>
              Caparazón Mall Center
            </button>

            <button
              id="btn-cinebol"
              class="map-btn px-8 py-3 rounded-full font-bold transition-all duration-300 bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 hover:bg-gray-300 dark:hover:bg-gray-600 transform scale-100 cursor-pointer flex items-center"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 mr-2 flex-shrink-0">
                <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/>
                <path d="m9 10 2 2 4-4"/>
              </svg>
              Cinebol El Alto
            </button>
          </div>

          <!-- 2. CONTENEDOR DEL MAPA -->
          <div class="relative group max-w-4xl mx-auto">
            <div class="absolute -inset-4 bg-gradient-to-r from-primary via-[#FF0040] to-primary rounded-[50px] blur-2xl opacity-20 group-hover:opacity-40 transition-opacity duration-1000 animate-gradient-x"></div>

            <div class="relative bg-white dark:bg-darkmode-light p-2 rounded-[42px] shadow-2xl overflow-hidden border border-white/20">
              <div class="aspect-video w-full rounded-[38px] overflow-hidden shadow-inner bg-gray-100">
                <iframe
                  id="mapa-iframe"
                  width="100%"
                  height="100%"
                  src="https://maps.google.com/maps?q=-16.49311355914987,-68.14514980491366&t=&z=17&ie=UTF8&iwloc=&output=embed"
                  class="w-full h-full border-0 transition-opacity duration-500 ease-in-out"
                  loading="lazy"
                  allowfullscreen
                  title="Mapa de la sucursal seleccionada"
                ></iframe>
              </div>
            </div>

            <p id="mapa-direccion" class="mt-6 text-lg font-semibold text-gray-800 dark:text-gray-200 transition-all duration-300">
               Sucursal Caparazón Mall Center, La Paz
            </p>
          </div>

        </div>
      </div>
    </div>
  </section>

 

  <!-- 3. LÓGICA CON EVENT LISTENERS (La forma correcta en Astro) -->
    <!-- 3. LÓGICA CON EVENT LISTENERS (Corregido para navegación en Astro) -->
  <script>
    type Lugar = 'caparazon' | 'cinebol';

    interface MapaData {
      src: string;
      direccion: string;
      btnActivo: string;
      btnInactivo: string;
    }

    const mapas: Record<Lugar, MapaData> = {
      caparazon: {
        src: "https://maps.google.com/maps?q=-16.49311355914987,-68.14514980491366&t=&z=17&ie=UTF8&iwloc=&output=embed",
        direccion: "Sucursal Caparazón Mall Center, La Paz",
        btnActivo: "btn-caparazon",
        btnInactivo: "btn-cinebol"
      },
      cinebol: {
        src: "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d956.2444631615817!2d-68.14905313036854!3d-16.527215713317002!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x915edf4d7c5ee75b%3A0x50ad520f8ab3bf8f!2sCINEBOL!5e0!3m2!1ses-419!2sbo!4v1791837829028!5m2!1ses-419!2sbo",
        direccion: "Sucursal Cinebol, El Alto",
        btnActivo: "btn-cinebol",
        btnInactivo: "btn-caparazon"
      }
    };

      function cambiarMapa(lugar: Lugar) {
      const data = mapas[lugar];
      const iframe = document.getElementById('mapa-iframe') as HTMLIFrameElement | null;
      const direccionText = document.getElementById('mapa-direccion') as HTMLElement | null;
      const btnActivo = document.getElementById(data.btnActivo) as HTMLElement | null;
      const btnInactivo = document.getElementById(data.btnInactivo) as HTMLElement | null;

      if (!iframe || !direccionText || !btnActivo || !btnInactivo) {
        console.error("No se encontraron los elementos del mapa en el DOM");
        return;
      }

      // Efecto de desvanecimiento
      iframe.style.opacity = '0';

      setTimeout(() => {
        iframe.src = data.src;
        direccionText.textContent = data.direccion;

        // ✅ CORRECCIÓN: Agregar 'flex items-center' en ambos botones
        btnActivo.className = "map-btn px-8 py-3 rounded-full font-bold transition-all duration-300 bg-primary text-white shadow-lg shadow-primary/30 transform scale-105 cursor-pointer flex items-center";
        btnInactivo.className = "map-btn px-8 py-3 rounded-full font-bold transition-all duration-300 bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 hover:bg-gray-300 dark:hover:bg-gray-600 transform scale-100 cursor-pointer flex items-center";

        // Volver a mostrar el mapa cuando termine de cargar
        iframe.onload = () => {
          iframe.style.opacity = '1';
        };
      }, 300);
    }

    //  FUNCIÓN DE INICIALIZACIÓN (Se ejecuta cada vez que se muestra la página)
    function inicializarBotonesMapa() {
      const btnCaparazon = document.getElementById('btn-caparazon');
      const btnCinebol = document.getElementById('btn-cinebol');

      // Truco: Clonamos el nodo para eliminar listeners anteriores y evitar
      // que se acumulen múltiples clics si el usuario navega ida y vuelta.
      if (btnCaparazon) {
        const nuevoBtnCaparazon = btnCaparazon.cloneNode(true);
        btnCaparazon.parentNode?.replaceChild(nuevoBtnCaparazon, btnCaparazon);
        nuevoBtnCaparazon.addEventListener('click', () => cambiarMapa('caparazon'));
      }

      if (btnCinebol) {
        const nuevoBtnCinebol = btnCinebol.cloneNode(true);
        btnCinebol.parentNode?.replaceChild(nuevoBtnCinebol, btnCinebol);
        nuevoBtnCinebol.addEventListener('click', () => cambiarMapa('cinebol'));
      }
    }

    // 1. Ejecutar en la primera carga de la página (navegación normal)
    document.addEventListener('DOMContentLoaded', inicializarBotonesMapa);

    // 2. Ejecutar en cada navegación interna de Astro (View Transitions o SPA)
    document.addEventListener('astro:page-load', inicializarBotonesMapa);

    // 3. Ejecutar después de que Astro termine de intercambiar el contenido de la página
    document.addEventListener('astro:after-swap', inicializarBotonesMapa);
  </script>

  <!-- /** PREGUINTAS FRECUENTES */ -->
    <!-- FAQ Section -->
  <section id="faq-section" class="section py-24 relative overflow-hidden bg-gray-50 dark:bg-darkmode-body">
    <div class="absolute inset-0 bg-primary/5 dark:bg-primary/5 -z-10"></div>

    <div class="container relative z-10">
      <div class="row justify-center">
        <div class="lg:col-10">
          
          <!-- Encabezado de la sección -->
          <div class="text-center mb-12">
            <h2 class="h2 mb-4 font-black text-gray-900 dark:text-white uppercase tracking-tight">
              Preguntas <span class="text-primary italic">Frecuentes</span>
            </h2>
            <p class="text-lg text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
              Aprende paso a paso cómo hacer tu pedido desde nuestros Lives y cómo verificar su estado en tiempo real.
            </p>
          </div>

          <!-- Contenedor de Acordeón -->
          <div class="max-w-3xl mx-auto space-y-4">
            
            <!-- Pregunta 1: Cómo pedir en Live -->
            <details class="group bg-white dark:bg-darkmode-light border border-gray-200 dark:border-darkmode-border rounded-2xl shadow-sm transition-all duration-300 open:shadow-md open:border-primary/30">
              <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
                <span class="text-lg font-semibold text-gray-900 dark:text-white group-open:text-primary transition-colors">
                  ¿Cómo hago un pedido desde un Live?
                </span>
                <span class="ml-4 flex-shrink-0 text-primary transition-transform duration-300 group-open:rotate-180">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                  </svg>
                </span>
              </summary>
              <div class="px-6 pb-6 text-gray-600 dark:text-gray-400 leading-relaxed">
                Es muy sencillo: 
                <ol class="list-decimal list-inside mt-2 space-y-2">
                  <li>Ve al <strong>Menú</strong> y selecciona la opción <strong>"Live"</strong>.</li>
                  <li>Completa tus datos: Nombre Completo, Cédula de Identidad (CI), Celular (WhatsApp) y Departamento.</li>
                  <li>Sube una <strong>captura de pantalla</strong> del producto que viste en el Live.</li>
                  <li>Adjunta tu comprobante de pago y haz clic en <strong>"Enviar Pedido"</strong>.</li>
                </ol>
              </div>
            </details>

            <!-- Pregunta 2: Cómo obtener el QR de pago (CORREGIDA) -->
            <details class="group bg-white dark:bg-darkmode-light border border-gray-200 dark:border-darkmode-border rounded-2xl shadow-sm transition-all duration-300 open:shadow-md open:border-primary/30">
              <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
                <span class="text-lg font-semibold text-gray-900 dark:text-white group-open:text-primary transition-colors">
                  ¿Cómo obtengo el código QR para realizar el pago?
                </span>
                <span class="ml-4 flex-shrink-0 text-primary transition-transform duration-300 group-open:rotate-180">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                  </svg>
                </span>
              </summary>
              <div class="px-6 pb-6 text-gray-600 dark:text-gray-400 leading-relaxed">
                Tienes dos opciones rápidas para obtener nuestro QR de pago:
                <ul class="list-disc list-inside mt-2 space-y-2">
                  <li><strong>Opción 1:</strong> Solicítalo directamente a nuestro número de WhatsApp de la importadora.</li>
                  <li><strong>Opción 2:</strong> En la parte superior del formulario de pedido, haz clic en <strong>"Ver QR"</strong>. Una vez que lo visualices, <strong>realiza el pago</strong> desde tu aplicación bancaria, <strong>adjunta la captura del comprobante</strong> en el formulario y, finalmente, haz clic en <strong>"Enviar Pedido"</strong>.</li>
                </ul>
                <p class="mt-4 p-3 bg-primary/10 dark:bg-primary/20 text-primary text-sm font-semibold rounded-lg flex items-start gap-2">
                  <svg class="w-5 h-5 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                  ¡Importante! No olvides adjuntar el comprobante de pago antes de enviar. Sin este paso, el sistema no podrá procesar tu solicitud.
                </p>
              </div>
            </details>

            <!-- Pregunta 3: Confirmación del pedido -->
            <details class="group bg-white dark:bg-darkmode-light border border-gray-200 dark:border-darkmode-border rounded-2xl shadow-sm transition-all duration-300 open:shadow-md open:border-primary/30">
              <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
                <span class="text-lg font-semibold text-gray-900 dark:text-white group-open:text-primary transition-colors">
                  ¿Cómo sé que mi pedido se registró correctamente?
                </span>
                <span class="ml-4 flex-shrink-0 text-primary transition-transform duration-300 group-open:rotate-180">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                  </svg>
                </span>
              </summary>
              <div class="px-6 pb-6 text-gray-600 dark:text-gray-400 leading-relaxed">
                ¡Es automático! Al hacer clic en el botón <strong>"Enviar Pedido"</strong>, el sistema te generará inmediatamente un <strong>código QR único de tu pedido</strong>. Te recomendamos tomar una captura de pantalla o guardar esa imagen, ya que la necesitarás para verificar tu compra.
              </div>
            </details>

            <!-- Pregunta 4: Cómo verificar el pedido -->
            <details class="group bg-white dark:bg-darkmode-light border border-gray-200 dark:border-darkmode-border rounded-2xl shadow-sm transition-all duration-300 open:shadow-md open:border-primary/30">
              <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
                <span class="text-lg font-semibold text-gray-900 dark:text-white group-open:text-primary transition-colors">
                  ¿Cómo puedo verificar el estado de mi pedido?
                </span>
                <span class="ml-4 flex-shrink-0 text-primary transition-transform duration-300 group-open:rotate-180">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                  </svg>
                </span>
              </summary>
              <div class="px-6 pb-6 text-gray-600 dark:text-gray-400 leading-relaxed">
                Ve al <strong>Menú</strong> y selecciona <strong>"Verificar tu pedido"</strong>. Allí tendrás dos opciones:
                <ul class="list-disc list-inside mt-2 space-y-2">
                  <li><strong>Verificar por QR:</strong> Usa la cámara de tu celular para escanear el QR de tu comprobante o sube la imagen guardada.</li>
                  <li><strong>Verificar con mis datos:</strong> Ingresa manualmente tu Número de Pedido, Cédula de Identidad (CI) y Número de Celular, luego haz clic en "Verificar ahora".</li>
                </ul>
              </div>
            </details>

            <!-- Pregunta 5: Qué hacer si no tengo el QR -->
            <details class="group bg-white dark:bg-darkmode-light border border-gray-200 dark:border-darkmode-border rounded-2xl shadow-sm transition-all duration-300 open:shadow-md open:border-primary/30">
              <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
                <span class="text-lg font-semibold text-gray-900 dark:text-white group-open:text-primary transition-colors">
                  ¿Puedo verificar mi pedido si perdí o no tengo el código QR?
                </span>
