---
import TwSizeIndicator from "@/components/TwSizeIndicator.astro";
import config from "@/config/config.json";
import theme from "@/config/theme.json";
import { plainify } from "@/lib/utils/textConverter";
import "@/styles/main.css";
import { AstroFont } from "astro-font";
import { ClientRouter } from "astro:transitions";
import ThemeSwitcher from "@/components/ThemeSwitcher.astro";
import { Toaster } from "react-hot-toast";

// font families
const pf = theme.fonts.font_family.primary;
const sf = theme.fonts.font_family.secondary;

let fontPrimary, fontSecondary;
if (theme.fonts.font_family.primary) {
  fontPrimary = theme.fonts.font_family.primary
    .replace(/\+/g, " ")
    .replace(/:[ital,]*[ital@]*[wght@]*[0-9,;.]+/gi, "");
}
if (theme.fonts.font_family.secondary) {
  fontSecondary = theme.fonts.font_family.secondary
    .replace(/\+/g, " ")
    .replace(/:[ital,]*[ital@]*[wght@]*[0-9,;.]+/gi, "");
}

const title = "Ingreso Mayorista | Importadora Miranda";
const meta_title = "Ingreso Mayorista";
const description =
  "Ingresa el código de acceso exclusivo para la sección de mayoristas";
---

<!doctype html>
<html lang="es">
  <head>
    <link rel="shortcut icon" href={config.site.favicon} />
    <meta name="theme-name" content="astroplate" />
    <meta name="generator" content={Astro.generator} />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=5"
    />
    <title>{title}</title>

    <AstroFont
      config={[
        {
          src: [],
          preload: false,
          display: "swap",
          name: fontPrimary!,
          fallback: "sans-serif",
          cssVariable: "font-primary",
          googleFontsURL: `https://fonts.googleapis.com/css2?family=${pf}&display=swap`,
        },
        {
          src: [],
          preload: false,
          display: "swap",
          name: fontSecondary!,
          fallback: "sans-serif",
          cssVariable: "font-secondary",
          googleFontsURL: `https://fonts.googleapis.com/css2?family=${sf}&display=swap`,
        },
      ]}
    />
    <ClientRouter />
    <meta name="description" content={description} />
  </head>
  <body class="overflow-x-hidden antialiased transition-colors duration-300">
    <TwSizeIndicator />
    <Toaster client:load />

    <main
      id="main-content"
      class="min-h-screen bg-gradient-to-br from-yellow-50 via-white to-gray-50 dark:from-darkmode-body dark:via-[#151515] dark:to-darkmode-body flex items-center justify-center p-4 relative transition-colors duration-500"
    >
      <!-- Theme Switcher - Fixed top left -->
      <div class="fixed top-4 left-4 sm:top-6 sm:left-6 z-50">
        <ThemeSwitcher className="!w-14 !h-8 p-1.5" />
      </div>

      <div
        class="w-full max-w-md mx-auto bg-white dark:bg-darkmode-light p-8 rounded-3xl shadow-2xl border border-gray-100 dark:border-darkmode-border z-10"
      >
        <div class="text-center mb-8">
          <div
            class="w-20 h-20 mx-auto bg-gradient-to-tr from-[#C5A021] to-[#D4AF37] rounded-3xl flex items-center justify-center shadow-lg transform rotate-3 mb-4"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-10 w-10 text-white"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
              ></path>
            </svg>
          </div>
          <h2 class="text-3xl font-bold text-gray-800 dark:text-white mb-2">
            Sección Mayoristas
          </h2>
          <p class="text-gray-500 dark:text-gray-400">
            Ingresa el código de acceso exclusivo
          </p>
        </div>

        <form id="wholesale-login-form" class="space-y-6">
          <div>
            <label
              for="code"
              class="block text-sm font-bold text-gray-700 dark:text-gray-300 mb-2 uppercase tracking-wide"
              >Código de Acceso</label
            >
            <input
              type="password"
              id="code"
              name="code"
              required
              placeholder="••••••••"
              class="w-full px-4 py-4 border-2 border-gray-200 dark:border-gray-700 rounded-2xl focus:border-[#D4AF37] focus:ring-4 focus:ring-[#D4AF37]/10 transition-all bg-gray-50 dark:bg-darkmode-body text-lg text-center tracking-widest"
            />
          </div>

          <button
            type="submit"
            class="w-full py-4 bg-gradient-to-r from-[#C5A021] to-[#D4AF37] text-white font-black rounded-2xl shadow-xl hover:shadow-2xl hover:scale-[1.02] active:scale-[0.98] transition-all transform uppercase tracking-widest text-lg"
          >
            Acceder al Catálogo
          </button>
        </form>

        <div
          id="error-message"
          class="hidden mt-4 p-4 bg-red-50 border border-red-100 text-red-600 rounded-2xl text-center text-sm font-medium animate-pulse"
        >
          Código de acceso incorrecto. Intente de nuevo.
        </div>
      </div>
    </main>

    <script is:inline>
      const form = document.querySelector("#wholesale-login-form");
      const errorMsg = document.querySelector("#error-message");

      if (form) {
        const submitBtn = form.querySelector("button");
        const originalBtnText = submitBtn.innerText;

        form.addEventListener("submit", (e) => {
          e.preventDefault();
          const code = document.querySelector("#code").value;

          // Feedback visual
          submitBtn.disabled = true;
          submitBtn.innerText = "Verificando...";

          if (code === "Miranda2026") {
            localStorage.setItem("wholesale_authenticated", "true");
            console.log("Wholesale authentication successful");

            // Pequeña pausa para asegurar el guardado en localStorage
            setTimeout(() => {
              window.location.replace("/mayorista");
            }, 500);
          } else {
            console.error("Wholesale authentication failed");
            errorMsg.classList.remove("hidden");
            submitBtn.disabled = false;
            submitBtn.innerText = originalBtnText;

            setTimeout(() => {
              errorMsg.classList.add("hidden");
            }, 3000);
          }
        });
      }
    </script>
  </body>
</html>
