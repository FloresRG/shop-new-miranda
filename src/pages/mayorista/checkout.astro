---
import WholesaleBase from "@/layouts/WholesaleBase.astro";
import WholesaleCheckoutForm from "@/components/shop/WholesaleCheckoutForm";
---

<WholesaleBase title="Finalizar Pedido VIP - Importadora Miranda">
  <section class="section pt-32 pb-20 bg-[#0c0c0c]">
    <div class="container">
      <div class="max-w-4xl mx-auto mb-12 text-center md:text-left">
        <h1 class="text-4xl md:text-6xl font-black text-white mb-4">
          Finalizar <span class="text-[#D4AF37]">Pedido VIP</span>
        </h1>
        <p class="text-gray-400 font-medium">
          Complete los detalles de su orden mayorista para procesar el envío.
        </p>
      </div>

      <div
        class="max-w-4xl mx-auto bg-[#1a1a1a] p-6 md:p-12 rounded-[2.5rem] shadow-2xl border border-[#D4AF37]/20 overflow-hidden relative"
      >
        <div class="absolute top-0 right-0 p-8 opacity-5">
          <svg width="200" height="200" viewBox="0 0 24 24" fill="currentColor"
            ><path d="M12 2L1 21h22L12 2zm0 3.45L20.27 19H3.73L12 5.45z"
            ></path></svg
          >
        </div>
        <WholesaleCheckoutForm client:only="react" />
      </div>
    </div>
  </section>
</WholesaleBase>
