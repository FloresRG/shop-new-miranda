---
import Base from "@/layouts/Base.astro";
import { getListPage } from "@/lib/contentParser.astro";
import PageHeader from "@/partials/PageHeader.astro";
import ContactForm from "@/components/shop/ContactForm";

const contactIndex = await getListPage("contact", "-index");
const { title, description, meta_title, image } = contactIndex.data;

if (contactIndex.data.draft) {
  return Astro.redirect("/404");
}
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
>
  <section class="p-2">
    <div class="container">
      <div class="row">
        <div class="mx-auto md:col-10 lg:col-6">
          <div
            class="flex flex-col md:flex-row items-center justify-between mb-8 gap-4 px-4"
          >
            <h2
              class="text-2xl md:text-3xl font-black text-dark dark:text-white uppercase tracking-tight"
            >
              PEDIDOS MIRANDA
            </h2>
            <a
              href="/liveqr?from=/live"
              class="inline-flex items-center gap-2 bg-primary/10 hover:bg-primary/20 text-primary border-2 border-primary/50 px-6 py-3 rounded-xl font-black text-lg transition-all transform hover:scale-105 active:scale-95 shadow-lg hover:shadow-primary/25"
            >
              <svg
                class="w-6 h-6"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2.5"
                  d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
              </svg>
              Ver QR
            </a>
          </div>

          <ContactForm client:load />
        </div>
      </div>
    </div>
  </section>
</Base>
