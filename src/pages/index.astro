---
import Base from "@/layouts/Base.astro";
import ProductGrid from "@/components/shop/ProductGrid.astro";
import BrandList from "@/components/shop/BrandList.astro";
import { getFeaturedProducts } from "@/lib/products";
import CartModal from "@/components/shop/CartModal";
import { FaArrowRight, FaTruck, FaShieldAlt, FaHeadset } from "react-icons/fa";

// Obtener productos destacados (8 items)
const featuredProducts = await getFeaturedProducts(8);
---

<Base>
  <CartModal client:idle />

  {/* Hero Moderno con Gradientes Corporativos */}
  <section
    class="relative min-h-[600px] flex items-center justify-center overflow-hidden bg-dark"
  >
    {/* Fondo abstracto dinámico */}
    <div class="absolute inset-0 bg-[#451773]">
      <div
        class="absolute -top-[20%] -left-[10%] w-[70%] h-[70%] bg-[#F2275D] rounded-full blur-[150px] opacity-40 animate-pulse"
      >
      </div>
      <div
        class="absolute top-[40%] -right-[10%] w-[60%] h-[60%] bg-[#17BFBF] rounded-full blur-[150px] opacity-30 animate-pulse delay-1000"
      >
      </div>
      <div
        class="absolute bottom-0 w-full h-1/2 bg-gradient-to-t from-[#121212] to-transparent"
      >
      </div>
    </div>

    <div class="container relative z-10 text-center text-white">
      <span
        class="inline-block py-1 px-3 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-accent font-bold text-xs uppercase tracking-[0.2em] mb-6 animate-in slide-in-from-bottom duration-700"
      >
        Tecnología Premium
      </span>
      <h1
        class="text-5xl lg:text-7xl font-extrabold mb-6 leading-tight animate-in slide-in-from-bottom duration-700 delay-100"
      >
        El futuro en <span
          class="text-transparent bg-clip-text bg-gradient-to-r from-[#F2275D] to-[#F20505]"
          >tus manos</span
        >
      </h1>
      <p
        class="text-lg lg:text-xl text-gray-300 mb-10 max-w-2xl mx-auto leading-relaxed animate-in slide-in-from-bottom duration-700 delay-200"
      >
        Descubre la colección más exclusiva de Smartwatches, Audio y Gadgets
        inteligentes. Importadora Miranda te trae la innovación que buscas.
      </p>
      <div
        class="flex flex-col sm:flex-row gap-4 justify-center animate-in slide-in-from-bottom duration-700 delay-300"
      >
        <a
          href="/tienda"
          class="btn bg-[#F2275D] hover:bg-[#d91648] text-white border-none py-4 px-8 rounded-full font-bold shadow-lg shadow-[#F2275D]/40 transition-all hover:scale-105 flex items-center justify-center gap-2"
        >
          Explorar Tienda <FaArrowRight />
        </a>
        <a
          href="/about"
          class="btn bg-white/10 hover:bg-white/20 text-white border border-white/10 py-4 px-8 rounded-full font-bold backdrop-blur-md transition-all"
        >
          Conócenos
        </a>
      </div>
    </div>
  </section>

  {/* Marcas */}
  <div
    class="bg-light dark:bg-dark p-8 border-b border-border dark:border-darkmode-border"
  >
    <BrandList />
  </div>

  {/* Productos Destacados */}
  <section class="section bg-body dark:bg-darkmode-body">
    <div class="container">
      <div
        class="flex flex-col md:flex-row justify-between items-end mb-12 gap-4"
      >
        <div>
          <span
            class="text-[#F2275D] font-bold uppercase tracking-wider text-sm"
            >Selección Exclusiva</span
          >
          <h2 class="h2 mt-2">Productos Destacados</h2>
        </div>
        <a
          href="/tienda"
          class="text-secondary dark:text-accent font-bold hover:underline"
          >Ver Todo el Catálogo &rarr;</a
        >
      </div>

      <ProductGrid products={featuredProducts} />
    </div>
  </section>

  {/* Features Modernas */}
  <section class="py-20 bg-gray-50 dark:bg-[#0f0f0f]">
    <div class="container">
      <div class="grid md:grid-cols-3 gap-8">
        <div
          class="bg-white dark:bg-[#1a1a1a] p-8 rounded-3xl shadow-xl shadow-gray-200/50 dark:shadow-none hover:-translate-y-2 transition-transform duration-300 border border-gray-100 dark:border-gray-800 group"
        >
          <div
            class="w-16 h-16 rounded-2xl bg-[#F2275D]/10 text-[#F2275D] flex items-center justify-center text-3xl mb-6 group-hover:bg-[#F2275D] group-hover:text-white transition-colors"
          >
            <FaTruck />
          </div>
          <h3 class="font-bold text-xl mb-3 dark:text-white">
            Envío Nacional Rápido
          </h3>
          <p class="text-gray-500 dark:text-gray-400 leading-relaxed">
            Llegamos a cada rincón del país con seguridad y rapidez garantizada.
          </p>
        </div>
        <div
          class="bg-white dark:bg-[#1a1a1a] p-8 rounded-3xl shadow-xl shadow-gray-200/50 dark:shadow-none hover:-translate-y-2 transition-transform duration-300 border border-gray-100 dark:border-gray-800 group"
        >
          <div
            class="w-16 h-16 rounded-2xl bg-[#451773]/10 text-[#451773] dark:text-[#a855f7] flex items-center justify-center text-3xl mb-6 group-hover:bg-[#451773] group-hover:text-white transition-colors"
          >
            <FaShieldAlt />
          </div>
          <h3 class="font-bold text-xl mb-3 dark:text-white">Compra Segura</h3>
          <p class="text-gray-500 dark:text-gray-400 leading-relaxed">
            Tus pagos están protegidos. Ofrecemos múltiples métodos de pago
            verificados.
          </p>
        </div>
        <div
          class="bg-white dark:bg-[#1a1a1a] p-8 rounded-3xl shadow-xl shadow-gray-200/50 dark:shadow-none hover:-translate-y-2 transition-transform duration-300 border border-gray-100 dark:border-gray-800 group"
        >
          <div
            class="w-16 h-16 rounded-2xl bg-[#17BFBF]/10 text-[#17BFBF] flex items-center justify-center text-3xl mb-6 group-hover:bg-[#17BFBF] group-hover:text-white transition-colors"
          >
            <FaHeadset />
          </div>
          <h3 class="font-bold text-xl mb-3 dark:text-white">
            Soporte Premium
          </h3>
          <p class="text-gray-500 dark:text-gray-400 leading-relaxed">
            ¿Dudas? Nuestro equipo de expertos está listo para ayudarte en
            WhatsApp.
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>
