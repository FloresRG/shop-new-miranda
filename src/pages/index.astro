---
import Base from "@/layouts/Base.astro";
import ProductGrid from "@/components/shop/ProductGrid.astro";
import { getFeaturedProducts } from "@/lib/products";
import CartModal from "@/components/shop/CartModal";
import { FaArrowRight } from "react-icons/fa";

// Obtener productos destacados (8 items)
const featuredProducts = await getFeaturedProducts(8);
---

<Base>
  <CartModal client:idle />

  {/* Hero Section Simplificado con énfasis en Shop */}
  <section
    class="relative bg-gradient-to-br from-primary/10 to-transparent py-20 lg:py-32 overflow-hidden"
  >
    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h1
          class="text-4xl lg:text-6xl font-bold text-dark dark:text-white mb-6 animate-in slide-in-from-bottom duration-700"
        >
          Bienvenido a <span class="text-primary">Importadora Miranda</span>
        </h1>
        <p
          class="text-lg text-gray-600 dark:text-gray-300 mb-8 animate-in slide-in-from-bottom duration-700 delay-150"
        >
          Encuentra lo último en tecnología, smartwatches y accesorios. Calidad
          garantizada y los mejores precios del mercado.
        </p>
        <div
          class="flex justify-center gap-4 animate-in slide-in-from-bottom duration-700 delay-300"
        >
          <a
            href="/tienda"
            class="btn btn-primary px-8 py-3 rounded-full flex items-center gap-2 transform hover:scale-105 transition-transform"
          >
            Ver Catálogo Completo <FaArrowRight />
          </a>
        </div>
      </div>
    </div>

    {/* Decoración de fondo */}
    <div
      class="absolute top-0 left-0 w-full h-full overflow-hidden -z-0 opacity-10 pointer-events-none"
    >
      <div
        class="absolute -top-20 -left-20 w-96 h-96 bg-primary rounded-full blur-3xl"
      >
      </div>
      <div
        class="absolute top-40 right-0 w-72 h-72 bg-secondary rounded-full blur-3xl"
      >
      </div>
    </div>
  </section>

  {/* Productos Destacados */}
  <section class="section">
    <div class="container">
      <div class="text-center mb-12">
        <span class="text-primary font-bold uppercase tracking-wider text-sm"
          >Novedades</span
        >
        <h2 class="h2 mt-2">Productos Destacados</h2>
      </div>

      <ProductGrid products={featuredProducts} />

      <div class="text-center mt-12">
        <a href="/tienda" class="btn btn-outline-primary rounded-full"
          >Explore todos los productos</a
        >
      </div>
    </div>
  </section>

  {/* Info / Features Section (Simplificado del original) */}
  <section class="section bg-theme-light dark:bg-darkmode-theme-light">
    <div class="container">
      <div class="grid md:grid-cols-3 gap-8 text-center">
        <div class="p-6">
          <div
            class="mx-auto w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center text-primary mb-4 text-2xl"
          >
            🚀
          </div>
          <h3 class="font-bold text-lg mb-2">Envíos Rápidos</h3>
          <p class="text-gray-600 dark:text-gray-400">
            Recibe tus productos en tiempo récord y con la mejor protección.
          </p>
        </div>
        <div class="p-6">
          <div
            class="mx-auto w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center text-primary mb-4 text-2xl"
          >
            🛡️
          </div>
          <h3 class="font-bold text-lg mb-2">Garantía Asegurada</h3>
          <p class="text-gray-600 dark:text-gray-400">
            Todos nuestros productos cuentan con garantía directa.
          </p>
        </div>
        <div class="p-6">
          <div
            class="mx-auto w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center text-primary mb-4 text-2xl"
          >
            🎧
          </div>
          <h3 class="font-bold text-lg mb-2">Soporte Dedicado</h3>
          <p class="text-gray-600 dark:text-gray-400">
            Atención personalizada para resolver todas tus dudas.
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>
