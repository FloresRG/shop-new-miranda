---
import Base from "@/layouts/Base.astro";
import BrandList from "@/components/shop/BrandList.astro";
import { getProducts, getFeaturedProducts } from "@/lib/products";
import CartModal from "@/components/shop/CartModal";
import CategoryCarousel from "@/components/CategoryCarousel";
import FeaturedProductsHelper from "@/components/shop/FeaturedProductsHelper";
import { FaArrowRight, FaTruck, FaShieldAlt, FaHeadset } from "react-icons/fa";

// Obtener categorías con un producto por cada una

// Obtener categorías con un producto por cada una
const data = await getProducts({ page: 1 });
const categorias = data.categorias.slice(0, 10);
const floatingProducts = await getFeaturedProducts(6);
const categoryProducts = await Promise.all(
  categorias.map(async (cat) => {
    const catData = await getProducts({ categoriaId: cat.id, page: 1 });
    const product = catData.productos[0];
    return product ? { category: cat, product } : null;
  }),
).then((results) => results.filter(Boolean));
---

<Base>
  <CartModal client:idle />

  {/* Hero Profesional con Productos Flotantes */}
  <section
    class="relative min-h-[600px] lg:min-h-[700px] flex items-center overflow-hidden bg-gradient-to-br from-[#0a0a0a] via-[#1a0a2e] to-[#0a0a0a]"
  >
    {/* Efectos de fondo con blur y gradientes */}
    <div class="absolute inset-0 opacity-40">
      <div
        class="absolute top-0 left-0 w-[500px] h-[500px] bg-[#F2275D] rounded-full blur-[180px] opacity-30 animate-pulse"
      >
      </div>
      <div
        class="absolute bottom-0 right-0 w-[600px] h-[600px] bg-[#451773] rounded-full blur-[200px] opacity-25 animate-pulse"
        style="animation-delay: 1s;"
      >
      </div>
      <div
        class="absolute top-1/2 left-1/3 w-[400px] h-[400px] bg-[#17BFBF] rounded-full blur-[160px] opacity-20 animate-pulse"
        style="animation-delay: 2s;"
      >
      </div>
    </div>

    {/* Grid decorativo de fondo */}
    <div
      class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,.03)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,.03)_1px,transparent_1px)] bg-[size:64px_64px] [mask-image:radial-gradient(ellipse_80%_50%_at_50%_50%,black,transparent)]"
    >
    </div>

    <div class="container relative z-10">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        {/* Contenido Principal - Lado Izquierdo */}
        <div class="text-white space-y-8 py-12 lg:py-0">
          {/* Badge animado */}
          <div
            class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/5 backdrop-blur-xl border border-white/10 shadow-lg"
          >
            <span class="relative flex h-2 w-2">
              <span
                class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#F2275D] opacity-75"
              ></span>
              <span
                class="relative inline-flex rounded-full h-2 w-2 bg-[#F2275D]"
              ></span>
            </span>
            <span
              class="text-sm font-semibold bg-gradient-to-r from-white to-gray-300 bg-clip-text text-transparent"
            >
              TECNOLOGÍA DE VANGUARDIA
            </span>
          </div>

          {/* Título Principal */}
          <div class="space-y-4">
            <h1
              class="text-4xl md:text-6xl lg:text-7xl font-black leading-[1.1] tracking-tight"
            >
              El futuro de la
              <span
                class="block mt-2 text-transparent bg-clip-text bg-gradient-to-r from-[#F2275D] via-[#F20505] to-[#ff6b9d] animate-gradient"
              >
                tecnología
              </span>
              <span class="block mt-2">en tus manos</span>
            </h1>

            <p
              class="text-lg md:text-xl text-gray-300/90 max-w-xl leading-relaxed font-light"
            >
              Explora la colección más exclusiva de <strong
                class="text-white font-semibold">Smartwatches</strong
              >,
              <strong class="text-white font-semibold">Audio</strong> y
              <strong class="text-white font-semibold">Gadgets</strong> inteligentes.
              Innovación que transforma tu día a día.
            </p>
          </div>

          {/* Botones de acción */}
          <div class="flex flex-col sm:flex-row gap-4 pt-4">
            <a
              href="/tienda"
              class="group relative inline-flex items-center justify-center gap-2 px-8 py-4 bg-gradient-to-r from-[#F2275D] to-[#F20505] rounded-full font-bold text-white shadow-[0_0_40px_rgba(242,39,93,0.4)] hover:shadow-[0_0_60px_rgba(242,39,93,0.6)] transition-all duration-300 hover:scale-[1.02] overflow-hidden"
            >
              <span class="relative z-10 flex items-center gap-2">
                Explorar Tienda
                <svg
                  class="w-5 h-5 group-hover:translate-x-1 transition-transform"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                </svg>
              </span>
              <div
                class="absolute inset-0 bg-gradient-to-r from-[#d91648] to-[#c70404] opacity-0 group-hover:opacity-100 transition-opacity"
              >
              </div>
            </a>

            <a
              href="/about"
              class="group inline-flex items-center justify-center gap-2 px-8 py-4 bg-white/5 hover:bg-white/10 backdrop-blur-xl border border-white/10 hover:border-white/20 rounded-full font-semibold text-white transition-all duration-300"
            >
              Conócenos
              <svg
                class="w-5 h-5 group-hover:rotate-45 transition-transform"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
          </div>

          {/* Stats o badges informativos */}
          <div class="flex flex-wrap gap-6 pt-4 text-sm">
            <div class="flex items-center gap-2 text-gray-300">
              <svg
                class="w-5 h-5 text-[#17BFBF]"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"
                ></path>
              </svg>
              <span><strong class="text-white">+10,000</strong> Clientes</span>
            </div>
            <div class="flex items-center gap-2 text-gray-300">
              <svg
                class="w-5 h-5 text-[#F2275D]"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
                ></path>
              </svg>
              <span><strong class="text-white">4.9/5</strong> Valoración</span>
            </div>
          </div>
        </div>

        {/* Productos Flotantes - Lado Derecho */}
        <div class="relative hidden lg:block h-[600px]">
          {
            floatingProducts.map((product, idx) => {
              const positions = [
                { top: "5%", right: "10%", delay: "0s", duration: "20s" },
                { top: "25%", right: "25%", delay: "2s", duration: "25s" },
                { top: "45%", right: "5%", delay: "4s", duration: "22s" },
                { top: "15%", right: "40%", delay: "1s", duration: "24s" },
                { top: "60%", right: "30%", delay: "3s", duration: "23s" },
                { top: "70%", right: "15%", delay: "5s", duration: "21s" },
              ];
              const pos = positions[idx];

              return (
                <div
                  key={product.id}
                  class="absolute w-32 h-32 animate-float-product opacity-0"
                  style={`top: ${pos.top}; right: ${pos.right}; animation-delay: ${pos.delay}; animation-duration: ${pos.duration};`}
                >
                  <div class="relative w-full h-full group">
                    {/* Glow effect */}
                    <div class="absolute inset-0 bg-gradient-to-br from-[#F2275D]/20 to-[#451773]/20 rounded-2xl blur-xl group-hover:blur-2xl transition-all" />

                    {/* Card del producto */}
                    <div class="relative w-full h-full bg-white/10 backdrop-blur-md border border-white/20 rounded-2xl p-2 shadow-2xl hover:scale-110 transition-transform duration-500">
                      <img
                        src={
                          product.fotos[0]?.foto
                            ? `${import.meta.env.PUBLIC_API_URL}/storage/${product.fotos[0].foto}`
                            : "https://placehold.co/200x200?text=Product"
                        }
                        alt={product.nombre}
                        class="w-full h-full object-cover rounded-xl"
                        loading="lazy"
                      />

                      {/* Overlay con info */}
                      <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity rounded-xl flex items-end p-3">
                        <div class="text-white">
                          <p class="text-xs font-bold truncate">
                            {product.nombre}
                          </p>
                          <p class="text-xs text-gray-300">
                            ${parseFloat(product.precio).toFixed(2)}
                          </p>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              );
            })
          }

          {/* Elementos decorativos adicionales */}
          <div
            class="absolute top-1/4 right-1/4 w-2 h-2 bg-white rounded-full animate-ping opacity-50"
          >
          </div>
          <div
            class="absolute top-2/3 right-1/3 w-1 h-1 bg-[#17BFBF] rounded-full animate-ping opacity-40"
            style="animation-delay: 1s;"
          >
          </div>
          <div
            class="absolute top-1/2 right-1/2 w-3 h-3 bg-[#F2275D] rounded-full animate-ping opacity-30"
            style="animation-delay: 2s;"
          >
          </div>
        </div>
      </div>
    </div>

    {/* Gradiente inferior para transición suave */}
    <div
      class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-body dark:from-darkmode-body to-transparent"
    >
    </div>
  </section>

  <style>
    @keyframes float-product {
      0% {
        opacity: 0;
        transform: translateY(100%) rotate(0deg) scale(0.8);
      }
      10% {
        opacity: 1;
      }
      50% {
        transform: translateY(-50%) rotate(180deg) scale(1);
      }
      90% {
        opacity: 1;
      }
      100% {
        opacity: 0;
        transform: translateY(-150%) rotate(360deg) scale(0.8);
      }
    }

    @keyframes gradient {
      0%,
      100% {
        background-position: 0% 50%;
      }
      50% {
        background-position: 100% 50%;
      }
    }

    .animate-float-product {
      animation: float-product linear infinite;
    }

    .animate-gradient {
      background-size: 200% 200%;
      animation: gradient 3s ease infinite;
    }
  </style>

  <CategoryCarousel categoryProducts={categoryProducts} client:load />

  

  {/* Productos Destacados */}
  <section class="section bg-body dark:bg-darkmode-body">
    <div class="container">
      <div
        class="flex flex-col md:flex-row justify-between items-end mb-12 gap-4"
      >
        <div>
          <span
            class="text-[#F2275D] font-bold uppercase tracking-wider text-sm"
            >Selección Exclusiva</span
          >
          <h2 class="h2 mt-2">Productos Destacados</h2>
        </div>
        <a
          href="/tienda"
          class="text-secondary dark:text-accent font-bold hover:underline"
          >Ver Todo el Catálogo &rarr;</a
        >
      </div>

      <FeaturedProductsHelper client:visible />
    </div>
  </section>
{/* Marcas */}
  <div
    class="bg-light dark:bg-dark p-8 border-b border-border dark:border-darkmode-border"
  >
    <BrandList />
  </div>
  {/* Features Modernas */}
  <section class="py-20 bg-gray-50 dark:bg-[#0f0f0f]">
    <div class="container">
      <div class="grid md:grid-cols-3 gap-8">
        <div
          class="bg-white dark:bg-[#1a1a1a] p-8 rounded-3xl shadow-xl shadow-gray-200/50 dark:shadow-none hover:-translate-y-2 transition-transform duration-300 border border-gray-100 dark:border-gray-800 group"
        >
          <div
            class="w-16 h-16 rounded-2xl bg-[#F2275D]/10 text-[#F2275D] flex items-center justify-center text-3xl mb-6 group-hover:bg-[#F2275D] group-hover:text-white transition-colors"
          >
            <FaTruck />
          </div>
          <h3 class="font-bold text-xl mb-3 dark:text-white">
            Envío Nacional Rápido
          </h3>
          <p class="text-gray-500 dark:text-gray-400 leading-relaxed">
            Llegamos a cada rincón del país con seguridad y rapidez garantizada.
          </p>
        </div>
        <div
          class="bg-white dark:bg-[#1a1a1a] p-8 rounded-3xl shadow-xl shadow-gray-200/50 dark:shadow-none hover:-translate-y-2 transition-transform duration-300 border border-gray-100 dark:border-gray-800 group"
        >
          <div
            class="w-16 h-16 rounded-2xl bg-[#451773]/10 text-[#451773] dark:text-[#a855f7] flex items-center justify-center text-3xl mb-6 group-hover:bg-[#451773] group-hover:text-white transition-colors"
          >
            <FaShieldAlt />
          </div>
          <h3 class="font-bold text-xl mb-3 dark:text-white">Compra Segura</h3>
          <p class="text-gray-500 dark:text-gray-400 leading-relaxed">
            Tus pagos están protegidos. Ofrecemos múltiples métodos de pago
            verificados.
          </p>
        </div>
        <div
          class="bg-white dark:bg-[#1a1a1a] p-8 rounded-3xl shadow-xl shadow-gray-200/50 dark:shadow-none hover:-translate-y-2 transition-transform duration-300 border border-gray-100 dark:border-gray-800 group"
        >
          <div
            class="w-16 h-16 rounded-2xl bg-[#17BFBF]/10 text-[#17BFBF] flex items-center justify-center text-3xl mb-6 group-hover:bg-[#17BFBF] group-hover:text-white transition-colors"
          >
            <FaHeadset />
          </div>
          <h3 class="font-bold text-xl mb-3 dark:text-white">
            Soporte Premium
          </h3>
          <p class="text-gray-500 dark:text-gray-400 leading-relaxed">
            ¿Dudas? Nuestro equipo de expertos está listo para ayudarte en
            WhatsApp.
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>
