---
import Base from "../../layouts/Base.astro";
import { getProducts } from "../../lib/products";
import SidebarFilters from "../../components/shop/SidebarFilters.astro";
import ProductGrid from "../../components/shop/ProductGrid.astro";
import SearchBar from "../../components/shop/SearchBar";
import CartModal from "../../components/shop/CartModal";

const { searchParams } = Astro.url;
const page = parseInt(searchParams.get("page") || "1");
const search = searchParams.get("search") || "";
const categoriaId = searchParams.get("categoria_id")
  ? parseInt(searchParams.get("categoria_id")!)
  : undefined;
const marcaId = searchParams.get("marca_id")
  ? parseInt(searchParams.get("marca_id")!)
  : undefined;
const tipoId = searchParams.get("tipo_id")
  ? parseInt(searchParams.get("tipo_id")!)
  : undefined;

// Ahora getProducts es async
const data = await getProducts({ page, search, categoriaId, marcaId, tipoId });
---

<Base title="Tienda - Importadora Miranda">
  <section class="section pt-14">
    <div class="container">
      <div class="flex flex-col lg:flex-row gap-8">
        <!-- Sidebar -->
        <SidebarFilters
          categories={data.categorias}
          brands={data.marcas}
          types={data.tipos}
          currentCategory={categoriaId}
          currentBrand={marcaId}
          currentType={tipoId}
        />

        <!-- Main Content -->
        <main class="flex-1">
          <div
            class="mb-6 flex flex-col sm:flex-row justify-between items-center gap-4"
          >
            <h1 class="h3">Nuestros Productos</h1>
            <SearchBar client:load />
          </div>

          <ProductGrid products={data.productos} />

          <!-- Pagination -->
          {
            data.pagination.last_page > 1 && (
              <div class="flex justify-center mt-8 gap-2">
                {data.pagination.prev_page_url && (
                  <a
                    href={searchParams
                      .toString()
                      .replace(/page=\d+/, `page=${page - 1}`)
                      .replace(/^$/, `?page=${page - 1}`)}
                    class="btn btn-outline-primary btn-sm"
                  >
                    Anterior
                  </a>
                )}
                <span class="px-4 py-2 text-sm font-medium">
                  Página {data.pagination.current_page} de{" "}
                  {data.pagination.last_page}
                </span>
                {data.pagination.next_page_url && (
                  <a
                    href={
                      searchParams.toString().includes("page")
                        ? searchParams
                            .toString()
                            .replace(/page=\d+/, `page=${page + 1}`)
                        : searchParams.toString()
                          ? `${searchParams.toString()}&page=${page + 1}`
                          : `?page=${page + 1}`
                    }
                    class="btn btn-outline-primary btn-sm"
                  >
                    Siguiente
                  </a>
                )}
              </div>
            )
          }
        </main>
      </div>
    </div>
  </section>
  <CartModal client:only="react" />
</Base>
