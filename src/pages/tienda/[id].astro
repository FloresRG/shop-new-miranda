---
import Base from "../../layouts/Base.astro";
import { getProductById, getProducts } from "../../lib/products";
import ProductDetail from "../../components/shop/ProductDetail";
import ProductGrid from "../../components/shop/ProductGrid.astro";

export const prerender = false;

const { id } = Astro.params;

if (!id) {
  return Astro.redirect("/404");
}

const productId = parseInt(id);

// Ya no bloqueamos el render con la búsqueda del producto en el servidor
// para permitir que el skeleton se muestre inmediatamente en el cliente/
// let product = null;
let relatedProducts = [];

// Opcional: Podríamos intentar cargar related products o metadatos básicos si es rápido,
// pero para la "experiencia YouTube" es mejor renderizar el shell HTML vacío rápido.
// Para SEO real, deberíamos mantener el SSR, pero el usuario pidió esto específicamente.

// Mock o datos básicos para el Base Layout (Title)
const pageTitle = "Cargando Producto...";
const pageDesc = "Detalles del producto";
---

<Base title={pageTitle} description={pageDesc}>
  <section class="">
    <div class="container">
      {/* Breadcrumb */}
      <nav
        class="flex text-sm text-gray-500 mb-8 overflow-x-auto whitespace-nowrap"
      >
        <a href="/" class="hover:text-primary transition-colors">Inicio</a>
        <span class="mx-2">/</span>
        <a href="/tienda" class="hover:text-primary transition-colors">Tienda</a
        >
        <span class="mx-2">/</span>
        <span class="text-dark dark:text-white font-medium truncate"
          >Detalle del Producto</span
        >
      </nav>

      <ProductDetail client:load productId={productId} />
    </div>
  </section>

  {
    /* Productos Relacionados - TODO: Mover a componente cliente para no bloquear carga */
  }
  {
    /* 
    relatedProducts.length > 0 && (
      <section class="section pt-0 pb-20">
        <div class="container">
          <h2 class="h4 mb-8 border-b border-border dark:border-darkmode-border pb-4">
            Productos Relacionados
          </h2>
          <ProductGrid products={relatedProducts} />
        </div>
      </section>
    )
  */
  }
</Base>
