---
import Logo from "@/components/Logo.astro";
import CartIcon from "../../components/shop/CartIcon";
import ProductSearch from "../../components/shop/ProductSearch";
import { FaSignOutAlt, FaStore, FaHome } from "react-icons/fa";

const { pathname } = Astro.url;

const menu = [
  { name: "Inicio", url: "/mayorista", icon: FaHome },
  { name: "Tienda", url: "/mayorista/tienda", icon: FaStore },
];
---

<header
  id="wholesale-header"
  class="z-30 sticky top-0 w-full bg-[#0c0c0c] border-b border-[#D4AF37]/30 py-4 shadow-xl overflow-hidden"
>
  <nav class="container flex flex-wrap items-center justify-between gap-4">
    <!-- logo -->
    <div class="flex items-center gap-3">
      <Logo />
      <div class="hidden sm:flex flex-col border-l border-[#D4AF37]/30 pl-3">
          <span class="text-[#D4AF37] font-black tracking-widest text-[9px] uppercase">Módulo Exclusivo</span>
          <span class="text-white font-bold text-xs tracking-tighter">MAYORISTAS</span>
      </div>
    </div>

    <!-- menu -->
    <ul class="navbar-nav hidden lg:flex items-center space-x-8 order-2">
      {
        menu.map((item) => (
          <li class="nav-item">
            <a
              href={item.url}
              class={`flex items-center gap-2 font-bold text-sm uppercase tracking-widest transition-colors ${
                pathname === item.url ? "text-[#D4AF37]" : "text-gray-400 hover:text-[#D4AF37]"
              }`}
            >
              <item.icon size={16} />
              {item.name}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- actions -->
    <div class="flex items-center gap-2 sm:gap-4 order-2 sm:order-3">
      <div class="hidden lg:block min-w-[200px]">
        <ProductSearch client:load />
      </div>
      <CartIcon client:load />
      
      <!-- Logout Button - Highly Visible -->
      <button 
        id="wholesale-logout-btn"
        class="bg-gradient-to-r from-red-600 to-red-800 text-white px-3 py-2 rounded-lg font-black text-[10px] uppercase tracking-widest flex items-center gap-2 hover:scale-105 transition-transform active:scale-95 shadow-lg shadow-red-900/20"
      >
        <FaSignOutAlt />
        <span class="hidden xs:inline">Salir</span>
      </button>
    </div>

    <!-- Mobile Search - Visible only on mobile -->
    <div class="w-full lg:hidden order-3 sm:order-2 px-2">
       <ProductSearch client:load />
    </div>
  </nav>
</header>

<script is:inline>
  function setupWholesaleLogout() {
    const logoutBtn = document.getElementById('wholesale-logout-btn');
    if (logoutBtn) {
      logoutBtn.addEventListener('click', () => {
        localStorage.removeItem('wholesale_authenticated');
        window.location.href = '/';
      });
    }
  }

  setupWholesaleLogout();
  document.addEventListener('astro:page-load', setupWholesaleLogout);
</script>
