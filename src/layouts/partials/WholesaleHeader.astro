---
import Logo from "@/components/Logo.astro";
import ThemeSwitcher from "@/components/ThemeSwitcher.astro";
import CartIcon from "../../components/shop/CartIcon";
import ProductSearch from "../../components/shop/ProductSearch";
import { FaSignOutAlt, FaStore, FaHome } from "react-icons/fa";

const { pathname } = Astro.url;

const menu = [
  { name: "Inicio Mayorista", url: "/mayorista", icon: FaHome },
  { name: "Tienda VIP", url: "/mayorista/tienda", icon: FaStore },
];
---

<header
  id="wholesale-header"
  class="z-30 sticky top-0 w-full bg-white dark:bg-[#0c0c0c] border-b border-[#D4AF37]/30 py-4 shadow-xl transition-colors duration-300"
>
  <nav class="navbar container flex items-center justify-between">
    <!-- logo -->
    <div class="flex items-center gap-4">
      <Logo />
      <div class="hidden md:flex flex-col border-l border-[#D4AF37]/30 pl-4">
          <span class="text-[#C5A021] dark:text-[#D4AF37] font-black tracking-widest text-[10px] uppercase">Módulo Exclusivo</span>
          <span class="text-dark dark:text-white font-bold text-sm tracking-tighter">MAYORISTAS</span>
      </div>
    </div>

    <!-- menu -->
    <ul class="navbar-nav hidden lg:flex items-center space-x-8">
      {
        menu.map((item) => (
          <li class="nav-item">
            <a
              href={item.url}
              class={`flex items-center gap-2 font-bold text-sm uppercase tracking-widest transition-colors ${
                pathname === item.url ? "text-[#D4AF37]" : "text-gray-400 hover:text-[#D4AF37]"
              }`}
            >
              <item.icon size={16} />
              {item.name}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- actions -->
    <div class="flex items-center gap-4">
      <div class="hidden md:block min-w-[200px]">
        <ProductSearch client:load />
      </div>
      <CartIcon client:load />
      <ThemeSwitcher />
      
      <!-- Logout Button - Highly Visible -->
      <button 
        id="wholesale-logout-btn"
        class="bg-gradient-to-r from-red-600 to-red-800 text-white px-4 py-2 rounded-xl font-black text-[10px] uppercase tracking-widest flex items-center gap-2 hover:scale-105 transition-transform active:scale-95 shadow-lg shadow-red-900/20"
      >
        <FaSignOutAlt />
        Salir
      </button>
    </div>
  </nav>
</header>

<script is:inline>
  function setupWholesaleLogout() {
    const logoutBtn = document.getElementById('wholesale-logout-btn');
    if (logoutBtn) {
      logoutBtn.addEventListener('click', () => {
        localStorage.removeItem('wholesale_authenticated');
        window.location.href = '/';
      });
    }
  }

  setupWholesaleLogout();
  document.addEventListener('astro:page-load', setupWholesaleLogout);
</script>
